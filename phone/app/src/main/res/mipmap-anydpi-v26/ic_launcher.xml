<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the v26 form, and that is deliberate rather than lazy: minSdk is
    26, so every device that can install this app draws adaptive icons and
    a set of legacy PNGs would be dead weight in the APK.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/oal_ink" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
