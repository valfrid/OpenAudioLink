<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window, before Compose has drawn anything.

        Dark in every configuration, with no values-night counterpart,
        because the app itself is dark in every configuration: the Hub's
        web UI has no light mode and matching it is the point. See
        Theme.kt, which makes the same choice for the same reason.

        The window background exists so the frame between the window
        opening and the first composition is the right colour — without it
        a phone set to light flashes white on the way in, which is the one
        moment an app gets to look considered.

        The system bars are here rather than in Compose because they are a
        window property and setting them from a composable means one frame
        drawn the old colour. windowLightStatusBar is false so the clock
        and the icons are drawn light against a dark bar; leaving it unset
        gives dark-on-dark on a phone whose system theme is light, which is
        an invisible status bar rather than a styled one.
    -->
    <style name="Theme.OpenAudioLink" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/oal_ink</item>
        <item name="android:statusBarColor">@color/oal_ink</item>
        <item name="android:navigationBarColor">@color/oal_ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
