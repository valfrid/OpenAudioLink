<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        Discovery does not work without this, and fails silently.

        The Wi-Fi chip filters multicast frames before they reach any
        socket unless a MulticastLock is held. Nothing reports an error;
        the speakers simply never appear, which looks exactly like a
        network problem.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
        The sender must keep running with the screen off. Without a
        foreground service the scheduler freezes it, and 5 ms packets do
        not survive Doze.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Reading the phone's own music. Nothing is uploaded anywhere. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Without this, nothing this app asks a speaker ever arrives.

        Android blocks cleartext HTTP by default from targetSdk 28, and
        every node endpoint in protocol/CONTROL.md is plain HTTP on port
        41001 — by design, because OpenAudioLink is local-first and a
        speaker on a house network has no certificate and no name to put on
        one. The failure is silent and looks like broken firmware: the
        first build on real hardware found the speakers over UDP discovery
        and then reported every one of them as having no volume control,
        because each status request had been refused before it left the
        phone.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.OpenAudioLink">

        <!--
            configChanges keeps the activity alive across a rotation or a
            keyboard appearing. Compose redraws from state either way, and
            a wall panel that tears down and rebuilds its activity when the
            accelerometer twitches is a panel that flickers on a wall.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Also offerable as the home app, which is what makes a wall
                panel a wall panel.

                Declaring it changes nothing on an ordinary phone: Android
                only asks which launcher to use when somebody presses Home,
                and a person who never chooses this one never sees it. On a
                device screwed to a wall, choosing it means the app comes
                back after a reboot, after a crash, and after anyone
                presses Home — without adb, without device owner, and
                without a BOOT_COMPLETED receiver, which from Android 10
                cannot reliably start an activity anyway.

                DEFAULT is required alongside HOME or the chooser will not
                offer it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".ProducerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
