<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>OpenAudioLink.Hub</RootNamespace>
    <Description>OpenAudioLink Hub: Controller, Windows Producer and Provisioner.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenAudioLink.Core\OpenAudioLink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
