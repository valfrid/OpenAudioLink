# OpenAudioLink test node defaults.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Log to the native USB port. The ESP32-S3 talks to a PC over its built-in
# USB Serial/JTAG peripheral, but ESP-IDF defaults the console to UART0 —
# which on these boards is not wired to the USB connector. Without this the
# board runs correctly and prints nothing at all.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Two OTA app slots so updates install into the inactive slot (Phase 2.6).
# The built-in table caps app partitions at 1 MB whatever the chip; ours is
# sized to the 8 MB confirmed on the XIAO ESP32S3. See partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# OTA images are fetched from the Hub over plain HTTP on the trusted local
# network; TLS for OTA is revisited before 1.0.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Mobile browsers send far more than the 512-byte default in request
# headers (User-Agent, Accept, sec-ch-*), which the HTTP server rejects
# with 431 before any handler runs — the provisioning form could not be
# submitted from a phone.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# A packet is due every 5 ms and the default tick is 10 ms, so the
# producer's vTaskDelay never had a whole tick to sleep and busy-spun the
# entire interval instead — 98% of every second at priority 6, never
# blocking. Nothing else needs that CPU today, but I2S DMA and a DAC will.
#
# This is deliberately the only change in 0.6.7. The retry logic that
# shipped alongside it in 0.6.5 is condemned: it cost 359 refusals and ten
# times the jitter against a baseline measured an hour earlier. The tick
# change was never tested apart from it.
CONFIG_FREERTOS_HZ=1000

# A stream is 200 packets a second, and the default pool of 32 dynamic
# transmit buffers runs short under that: a first measured link lost
# nothing over the air yet still dropped fifteen packets, every one
# refused by the driver before it left. Doubling the pool costs a little
# heap on a board with 8 MB of PSRAM available.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64

# lwIP's default of ten sockets is thin for a device that runs an HTTP
# server, an HTTP client, an RTP socket and discovery at once. Seven were
# left for the control server, and losing them took the whole control
# plane down while audio carried on playing: no status, no portal, no OTA,
# and a log full of accept errors. Sixteen costs a few hundred bytes.
CONFIG_LWIP_MAX_SOCKETS=16

# The RTP receive queue, which run 28 found was not the size this project
# thought it was.
#
# `oal_stream_consumer.c` asks for a receive buffer several packets deep and
# has since the stream existed. lwIP only compiles that option in when
# LWIP_SO_RCVBUF is set, which this build never set, so every call was
# rejected — and the return value was discarded, so it was rejected quietly
# for months. The real ceiling was the UDP receive mailbox: a handful of
# packets, tens of milliseconds.
#
# The evidence is a controlled pair. Two nodes, one access point, the same
# second: the dongle at −48 dBm lost 3 500 ppm while the speaker at −52 dBm
# lost nothing at all. Better signal, more loss. That is not radio — that is
# the busier node dropping packets it had already received, which is exactly
# what the comment in that file warned about.
#
# Sixty-four packets is 320 ms, chosen against the same run's measurement:
# delivery stalls of 900 ms happen on this network, and a queue that cannot
# hold a stall cannot hand the ring a burst to recover from.
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64

# And the driver's receive pool to match, for the same reason the transmit
# pool above was doubled. A socket queue sixty-four packets deep is a
# promise the Wi-Fi driver has to keep: queued packets sit in *its* buffers
# until the consumer task reads them, and its default pool is thirty-two.
# Raising only the mailbox would move the drop from lwIP into the driver
# and change nothing a node can measure.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64

# The USB dongle output stage (docs/USB-AUDIO.md), required by
# esp-uac2-host. The first is large enough for a UAC 2.0 configuration
# descriptor — the measured dongle's runs well past the 256-byte default —
# and the second biases the host controller's buffer allocation towards
# periodic OUT traffic, which is what isochronous playback is.
#
# Set unconditionally, because one image serves a board with a DAC and a
# board with a dongle. They cost a little static allocation on a node that
# never hosts anything, which is the price of not having two firmwares.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y
